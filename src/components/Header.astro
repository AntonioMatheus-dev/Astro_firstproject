---
import Navigation from './Navigation.astro';
import Menu from './Menu.astro';
import ThemeIcon from './ThemeIcon.astro';
---
<header>
  <nav aria-label="Navegação principal">
    <div>
      <a class="site-brand" href="/" aria-label="Antonio Matheus — página inicial">
        <img class="brand-logo" src="/favicon.png" alt="" aria-hidden="true" />
        <span>Antonio Matheus</span>
      </a>
      <ThemeIcon />
      <Menu />
    </div>
    <Navigation />
  </nav>
</header>

<style>
  header {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand-logo {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }
</style>