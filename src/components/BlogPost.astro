---
const { title, url, description, pubDate } = Astro.props;
const date = pubDate ? new Date(pubDate) : undefined;
---

<li class="post-card">
  {date && <time class="post-date" datetime={date.toISOString()}>{date.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>}
  <h2><a href={url}>{title}</a></h2>
  {description && <p>{description}</p>}
</li>