---
const {platform, username} = Astro.props;
---

<a class="footer-social" href={`https://${platform}.com/${username}`} target="_blank" rel="noreferrer">
  GitHub <span class="visually-hidden">de {username}</span> ↗
</a>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>